# --- CONFIGURACIÓN DE SEGURIDAD Y ENTORNO ---
# Genera secretos aleatorios de al menos 32 bytes; no uses estos ejemplos.
SECRET_KEY=tu_clave_secreta
PEPPER=tu_pepper_para_hashes
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=2
REFRESH_TOKEN_EXPIRE_DAYS=1

# --- BASES DE DATOS Y CACHÉ ---
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/nombre_bd
REDIS_URL=redis://localhost:6379/0

# --- CONFIGURACIÓN DE TOKENS (JWT) ---
JWT_ISSUER=https://tu-dominio.com
JWT_AUDIENCE=tu-app-client-id

# Solo para una base vacía; usa un secreto de entre 15 y 128 caracteres.
BOOTSTRAP_ADMIN_PASSWORD=

# Orígenes completos sin barra final; incluye solo clientes autorizados.
FRONTEND_ORIGINS=[]
COOKIE_SAMESITE=lax
# Producción siempre exige Secure. Cross-site exige none y HTTPS.
# COOKIE_SECURE=true
MAX_REQUEST_BYTES=16384
